@startuml
title Sequence Diagram - Tao video moi / Upload video
autonumber
autoactivate on

actor "Creator" as Creator
participant "Frontend" as FE
participant "API Gateway" as GW
participant "Media Service" as MS
database "Video Store" as VideoStore
database "Upload Session Store" as UploadStore
participant "Object Storage" as Storage
queue "Outbox / Message Broker" as Broker
participant "Moderation Service" as Moderation

Creator -> FE: Nhap thong tin va chon file video
FE -> FE: Kiem tra form va kich thuoc file
FE -> GW: Gui yeu cau bat dau upload
GW -> GW: Kiem tra phien dang nhap

alt Chua dang nhap
  GW --> FE: Tu choi yeu cau
  FE --> Creator: Hien thi yeu cau dang nhap
else Da dang nhap
  GW -> MS: Chuyen tiep yeu cau bat dau upload
  MS -> MS: Kiem tra kenh creator, danh muc, tag va file

  alt Thong tin khong hop le
    MS --> GW: Thong bao tao video that bai
    GW --> FE: Tra ket qua
    FE --> Creator: Hien thi loi tao video
  else Thong tin hop le
    MS -> VideoStore: Luu video ban nhap
    VideoStore --> MS: Tra videoId
    MS -> Storage: Tao multipart upload
    Storage --> MS: Tra uploadId
    MS -> UploadStore: Luu phien upload
    UploadStore --> MS: Da ghi nhan
    MS --> GW: Tra videoId va uploadId
    GW --> FE: Tra ket qua

    loop Moi nhom part can upload
      FE -> GW: Yeu cau URL upload part
      GW -> MS: Chuyen tiep yeu cau URL
      MS -> UploadStore: Kiem tra phien upload
      UploadStore --> MS: Phien upload hop le
      MS -> Storage: Tao URL upload part
      Storage --> MS: Tra URL upload part
      MS --> GW: Tra danh sach URL
      GW --> FE: Tra ket qua

      FE -> Storage: Upload part video
      Storage --> FE: Tra etag
      FE -> GW: Thong bao part da upload
      GW -> MS: Chuyen tiep thong tin part
      MS -> UploadStore: Luu part da upload
      UploadStore --> MS: Da ghi nhan
      MS --> GW: Tra ket qua part
      GW --> FE: Tra ket qua
    end

    FE -> GW: Yeu cau hoan tat multipart upload
    GW -> MS: Chuyen tiep yeu cau hoan tat
    MS -> UploadStore: Kiem tra cac part da upload

    alt Thieu part upload
      UploadStore --> MS: Chua du part
      MS --> GW: Thong bao thieu part
      GW --> FE: Tra ket qua
      FE --> Creator: Hien thi loi upload
    else Du part upload
      UploadStore --> MS: Du part
      MS -> Storage: Hoan tat multipart upload
      Storage --> MS: Da hoan tat upload
      MS -> UploadStore: Danh dau upload hoan tat
      UploadStore --> MS: Da cap nhat
      MS --> GW: Tra ket qua hoan tat upload
      GW --> FE: Tra ket qua

      FE -> GW: Nop video de xu ly
      GW -> MS: Chuyen tiep yeu cau submit
      MS -> VideoStore: Lay video ban nhap
      VideoStore --> MS: Tra thong tin video
      MS -> Storage: Kiem tra file raw va thumbnail

      alt File upload khong hop le
        Storage --> MS: File khong hop le
        MS --> GW: Thong bao submit that bai
        GW --> FE: Tra ket qua
        FE --> Creator: Hien thi loi upload
      else File upload hop le
        Storage --> MS: File hop le
        MS -> Storage: Chuyen file raw sang confirmed
        Storage --> MS: Da chuyen file
        MS -> VideoStore: Cap nhat trang thai cho kiem duyet
        VideoStore --> MS: Da cap nhat
        MS ->> Broker: Phat su kien video.moderation.requested
        Broker ->> Moderation: Chuyen su kien kiem duyet
        MS --> GW: Tra ket qua cho kiem duyet
        GW --> FE: Tra ket qua
        FE --> Creator: Hien thi video dang cho kiem duyet
      end
    end
  end
end

@enduml
