@startuml
title Sequence Diagram - Mo khoa video
autonumber
autoactivate on

actor "Viewer" as Viewer
participant "Frontend" as FE
participant "API Gateway" as GW
participant "Media Service" as MS
database "Video Store" as VideoStore
database "Unlock Store" as UnlockStore
participant "Finance Service" as FS

Viewer -> FE: Chon mo khoa video
FE -> FE: Hien thi gia va xac nhan mua
FE -> GW: Gui yeu cau mo khoa video
GW -> GW: Kiem tra phien dang nhap

alt Chua dang nhap
  GW --> FE: Tu choi yeu cau
  FE --> Viewer: Hien thi yeu cau dang nhap
else Da dang nhap
  GW -> MS: Chuyen tiep yeu cau mo khoa
  MS -> VideoStore: Lay thong tin video

  alt Video khong ton tai
    VideoStore --> MS: Khong tim thay video
    MS --> GW: Thong bao video khong ton tai
    GW --> FE: Tra ket qua
    FE --> Viewer: Hien thi loi mo khoa
  else Video ton tai
    VideoStore --> MS: Tra thong tin video
    MS -> MS: Kiem tra chu so huu video

    alt Viewer la chu video
      MS --> GW: Tu choi mo khoa video cua chinh minh
      GW --> FE: Tra ket qua
      FE --> Viewer: Hien thi thong bao khong hop le
    else Viewer khong phai chu video
      MS -> MS: Kiem tra video san sang va cong khai

      alt Video khong the mo khoa
        MS --> GW: Thong bao video khong the mo khoa
        GW --> FE: Tra ket qua
        FE --> Viewer: Hien thi loi mo khoa
      else Video co the mo khoa
        MS -> MS: Kiem tra gia video

        alt Video khong can thanh toan
          MS --> GW: Thong bao video khong can mua
          GW --> FE: Tra ket qua
          FE --> Viewer: Hien thi thong bao
        else Video can thanh toan
          MS -> UnlockStore: Kiem tra da mo khoa chua

          alt Da mo khoa truoc do
            UnlockStore --> MS: Da co quyen mo khoa
            MS --> GW: Tra ket qua da mo khoa
            GW --> FE: Tra ket qua
            FE --> Viewer: Hien thi video da mo khoa
          else Chua mo khoa
            UnlockStore --> MS: Chua co quyen mo khoa
            MS -> FS: Yeu cau tru tien mua video

            alt Thanh toan that bai
              FS --> MS: Tra ket qua that bai
              MS --> GW: Thong bao thanh toan that bai
              GW --> FE: Tra ket qua
              FE --> Viewer: Hien thi loi thanh toan
            else Thanh toan thanh cong
              FS --> MS: Tra thong tin giao dich
              MS -> MS: Kiem tra giao dich thanh toan

              alt Giao dich khong hop le
                MS --> GW: Thong bao mo khoa that bai
                GW --> FE: Tra ket qua
                FE --> Viewer: Hien thi loi mo khoa
              else Giao dich hop le
                MS -> UnlockStore: Luu quyen mo khoa video
                UnlockStore --> MS: Da ghi nhan
                MS --> GW: Tra ket qua mo khoa thanh cong
                GW --> FE: Tra ket qua
                FE --> Viewer: Hien thi nut xem video
              end
            end
          end
        end
      end
    end
  end
end

@enduml
