NODE_ENV=development
PORT=4002

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=media_db
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_QUEUE_NAME=video-processing

# Kafka
KAFKA_ENABLE=true
KAFKA_CLIENT_ID=media-service
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=media-service-group
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPICS_TO_CREATE=membership.payment.success,video.payment.success,video.processed.success,video.processed.failed,video.viewed,video.moderation.requested,video.moderation.completed,video.moderation.outcome
KAFKA_MEMBERSHIP_PAYMENT_SUCCESS_TOPIC=membership.payment.success
KAFKA_VIDEO_PAYMENT_SUCCESS_TOPIC=video.payment.success
KAFKA_VIDEO_MODERATION_REQUESTED_TOPIC=video.moderation.requested
KAFKA_VIDEO_MODERATION_COMPLETED_TOPIC=video.moderation.completed
KAFKA_VIDEO_MODERATION_OUTCOME_TOPIC=video.moderation.outcome
KAFKA_VIDEO_PROCESSED_SUCCESS_TOPIC=video.processed.success
KAFKA_VIDEO_PROCESSED_FAILED_TOPIC=video.processed.failed
KAFKA_VIDEO_VIEW_TOPIC=video.viewed
KAFKAJS_NO_PARTITIONER_WARNING=1

# MinIO
# Source of truth for local/dev MinIO runtime config. All fields below are required.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Optional public endpoint for presigned URLs returned to clients.
# Set these when backend talks to MinIO locally/docker, but laptops in LAN must upload via machine IP/domain.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_RAW_BUCKET=media-raw
MINIO_PROCESSED_BUCKET=media-processed

# Playback
INTERNAL_GATEWAY_SECRET=gateway-secret
PLAYBACK_TOKEN_SECRET=change-me-in-production
PLAYBACK_TOKEN_TTL_SECONDS=300
VIDEO_VIEW_DEDUPE_TTL_SECONDS=1800
VIDEO_VIEW_MIN_SECONDS=10
VIDEO_VIEW_MIN_PERCENT=20
VIDEO_VIEW_FLUSH_INTERVAL_SECONDS=5
VIDEO_VIEW_DISCOVERY_INVALIDATION_INTERVAL_SECONDS=60
VIDEO_MAX_UPLOAD_SIZE_BYTES=2147483648

# Membership rules
MEMBERSHIP_MIN_PRICE_LV1=0
MEMBERSHIP_MIN_PRICE_LV2=0
MEMBERSHIP_MIN_PRICE_LV3=0
CHANNEL_MEMBERSHIP_MIN_READY_VIDEOS=5
CHANNEL_MEMBERSHIP_MIN_TOTAL_VIEWS=1000

MEDIA_PROCESSING_SERVICE_HEALTH_URL=http://localhost:4003/health/ready
MODERATION_SERVICE_HEALTH_URL=http://localhost:8000/health/ready
